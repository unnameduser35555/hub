<!doctype html>

<html lang="ja">  
<head>  
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">  
<title>Google</title>  
<style>  
:root{color-scheme:dark;--bg:#000;--panel:#080808;--line:#242424;--text:#eee;--muted:#777;--hover:#111}  
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}main{max-width:980px;margin:auto;padding:56px 24px 80px}.top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:80px}.brand{font-weight:650;letter-spacing:-.03em;font-size:20px}.status{font-size:11px;color:#666;letter-spacing:.12em}.intro{margin-bottom:42px}.eyebrow{font-size:11px;color:#555;letter-spacing:.16em;text-transform:uppercase}.intro h1{font-size:clamp(36px,7vw,66px);line-height:1.05;letter-spacing:-.065em;font-weight:600;margin:14px 0}.intro p{color:#777;margin:0;max-width:420px}.section{margin-top:48px}.section-head{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:0}.section h2{font-size:12px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0}.count{color:#555;font-size:12px}.item{display:flex;align-items:center;gap:18px;padding:19px 0;border-bottom:1px solid #171717;text-decoration:none;color:inherit;transition:background .18s,padding .18s}.item:hover{background:var(--hover);padding-left:12px;padding-right:12px}.num{color:#444;font-variant-numeric:tabular-nums;width:25px}.item-main{flex:1;min-width:0}.name{font-size:15px;font-weight:520;letter-spacing:-.015em}.desc{font-size:12px;color:#666;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.arrow{color:#555}.empty{padding:24px 0;color:#555}.link-url{font-size:12px;color:#666;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.footer{margin-top:80px;color:#444;font-size:11px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}@media(max-width:520px){main{padding:32px 18px 60px}.top{margin-bottom:60px}.item{gap:10px}.num{width:18px}.name{font-size:14px}}  
</style></head>  
<body><main>  
<header class="top"><div class="brand">KoyotaHUB</div><div class="status">REPOSITORY / KoyotaHUB</div></header>  
<section class="intro"><div class="eyebrow">A small collection</div><h1>Koyota HUB.</h1><p>Useful things, small experiments, and links collected in one place.</p></section>  
<section class="section"><div class="section-head"><h2>Works</h2><span class="count" id="workCount">—</span></div><div id="works"><div class="empty">Loading repository…</div></div></section>  
<section class="section"><div class="section-head"><h2>Links</h2><span class="count" id="linkCount">—</span></div><div id="links"><div class="empty">Loading links…</div></div></section>  
<footer class="footer"><span>KoyotaHUB · github pages</span><span id="updated">—</span></footer>  
</main>  
<script>  
const OWNER='unnameduser35555',REPO='hub',BRANCH='main';  
const $=id=>document.getElementById(id);  
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));  
async function api(path){const r=await fetch('https://api.github.com/repos/'+OWNER+'/'+REPO+'/contents/'+path+'?ref='+BRANCH,{headers:{Accept:'application/vnd.github+json'}});if(!r.ok)throw Error(r.status);return r.json()}  
function fileName(name){const m=name.match(/^(.*?)(?::(.*?))?\.html$/i);return m?{name:m[1],desc:m[2]||'HTML work'}:null}  
function renderWorks(files){const items=files.filter(f=>f.type==='file'&&/\.html$/i.test(f.name)&&f.name.toLowerCase()!=='index.html').map(f=>({f,meta:fileName(f.name)})).filter(x=>x.meta);$('workCount').textContent=String(items.length).padStart(2,'0');$('works').innerHTML=items.length?items.map((x,i)=>{const customUrl='/'+encodeURIComponent(x.f.name);return `<a class="item" href="${esc(customUrl)}" target="_blank" rel="noopener"><span class="num">${String(i+1).padStart(2,'0')}</span><span class="item-main"><div class="name">${esc(x.meta.name)}</div><div class="desc">${esc(x.meta.desc)}</div></span><span class="arrow">↗</span></a>`}).join(''):'<div class="empty">No works found.</div>'}  
function renderLinks(text){const lines=text.split(/\r?\n/).map(x=>x.trim()).filter(Boolean).filter(x=>!x.startsWith('#'));const items=lines.map(x=>{const m=x.match(/^(.+?)\s*\|\s*(https?:\/\/\S+)$/);return m?{name:m[1],url:m[2]}:{name:x,url:x}}).filter(x=>/^https?:\/\//.test(x.url));$('linkCount').textContent=String(items.length).padStart(2,'0');$('links').innerHTML=items.length?items.map((x,i)=>`<a class="item" href="${esc(x.url)}" target="_blank" rel="noopener"><span class="num">${String(i+1).padStart(2,'0')}</span><span class="item-main"><div class="name">${esc(x.name)}</div><div class="link-url">${esc(x.url)}</div></span><span class="arrow">↗</span></a>`).join(''):'<div class="empty">No links found.</div>'}  
async function init(){try{const files=await api('');renderWorks(files);try{const r=await fetch(''/link.txt');renderLinks(r.ok?await r.text():'')}catch{renderLinks('')} $('updated').textContent='SYNCED · '+new Date().toLocaleDateString('ja-JP')}catch(e){$('works').innerHTML='<div class="empty">Repository could not be loaded.</div>';$('links').innerHTML='<div class="empty">Check GitHub API access or repository visibility.</div>';console.error(e)}}init();  
</script></body></html>
